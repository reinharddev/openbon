# OpenBon environment variables.
# Copy this file to `.env.local` for local development, and to `.env.production`
# (or set them before `npm run deploy`) for production.
#
# All of these are NEXT_PUBLIC_*, so they are read at BUILD time and end up in the
# public bundle. Never put secrets in here. Every variable is optional.

# Public origin of the site, no trailing slash. Used for canonical URLs, the
# sitemap, and social preview links. Set this in production.
# Examples: https://openbon.my.id  |  https://openbon.<account>.workers.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Donation link (Saweria, Ko-fi, GitHub Sponsors, ...).
# The "Support OpenBon" link is hidden when this is empty.
NEXT_PUBLIC_DONATE_URL=

# GitHub repository URL. Enables the GitHub pill with a live star count in the
# navbar/footer and the "Still stuck?" card in the FAQ. Hidden when empty.
# Example: https://github.com/<username>/openbon
NEXT_PUBLIC_REPO_URL=
